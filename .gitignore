# Keep this file specific to this repo. Rules without a leading "/" match at
# ANY depth, so a generic folder name (lib/, build/, dist/, env/…) can silently
# hide source code. Anchor rules to where they apply (e.g. /frontend/dist/).

# ── Go ───────────────────────────────────────────────────────────────────────
/tscm-change-detection
/tscm-change-detection.exe
*.test
*.out
coverage.html

# ── Frontend (Bun / React) — see also frontend/.gitignore ─────────────────────
/frontend/node_modules/
/frontend/dist/
*.tsbuildinfo

# ── Python prototyping scripts (scripts/prototyping only) ─────────────────────
/scripts/prototyping/.venv/
/scripts/prototyping/venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ── Local environment / secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Editors and OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Scratch space for experiments, captures and test data (never commit) ─────
/tmp/
