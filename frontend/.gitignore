# Paths are relative to frontend/. A leading "/" anchors a rule to this folder;
# without it the rule matches at any depth and could hide source files.

# dependencies (bun install)
/node_modules/

# build output
/out/
/dist/
*.tgz

# code coverage
/coverage/
*.lcov

# logs
/logs/
*.log

# dotenv environment variable files
.env
.env.*.local
.env.local

# caches
.eslintcache
/.cache/
*.tsbuildinfo

# editors / OS
.idea/
.DS_Store
